{
  "name": "phone-repair-backend",
  "version": "1.0.0",
  "description": "Cloudflare Workers REST API with D1 and R2 for Phone Repair Platform (Algeria)",
  "main": "src/index.ts",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply phone-repair-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply phone-repair-db --remote",
    "db:seed:local": "wrangler d1 execute phone-repair-db --local --file=./scripts/seed.sql",
    "test": "vitest run"
  },
  "keywords": [
    "cloudflare-workers",
    "hono",
    "d1",
    "r2",
    "repair-management"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@hono/zod-validator": "^0.4.3",
    "hono": "^4.7.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "wrangler": "^3.111.0"
  }
}
